pipeline {
    agent any

    options {
        timestamps()
    }

    environment {
        IMAGE_NAME = 'cityinfo-api'
        IMAGE_TAG = 'jenkins'
        SDK_IMAGE = 'cityinfo-sdk-multi:local'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Source code is checked out by Jenkins SCM configuration.'
                sh 'git status --short'
            }
        }

        stage('Restore') {
            steps {
                sh '''
                    docker run --rm \
                      -v jenkins_home:/var/jenkins_home \
                      -v dotnet_nuget_cache:/root/.nuget \
                      -w "$WORKSPACE" \
                      "$SDK_IMAGE" \
                      dotnet restore Cityinfo.sln
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                    docker run --rm \
                      -v jenkins_home:/var/jenkins_home \
                      -v dotnet_nuget_cache:/root/.nuget \
                      -w "$WORKSPACE" \
                      "$SDK_IMAGE" \
                      dotnet build Cityinfo.sln --no-restore
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    docker run --rm \
                      -v jenkins_home:/var/jenkins_home \
                      -v dotnet_nuget_cache:/root/.nuget \
                      -w "$WORKSPACE" \
                      "$SDK_IMAGE" \
                      dotnet test Cityinfo.sln --no-build \
                      --logger "console;verbosity=normal"
                '''
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build \
                      -t "$IMAGE_NAME:$IMAGE_TAG" \
                      -f Dockerfile .
                '''
            }
        }
    }

    post {
        success {
            echo 'CI pipeline completed successfully.'
        }
        failure {
            echo 'CI pipeline failed. Check the stage logs.'
        }
        always {
            echo 'Pipeline execution finished.'
        }
    }
}