
pipeline {
    agent any

    options {
        timestamps()
    }

    environment {
        IMAGE_NAME = 'cityinfo-api'
        IMAGE_TAG  = 'jenkins'
        SDK_IMAGE  = 'cityinfo-sdk-multi:local'
        SONAR_KEY  = 'City-Info-API'
        SONAR_URL  = 'http://sonarqube:9000'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Source code is checked out by Jenkins SCM configuration.'
                sh 'git status --short'
            }
        }

        stage('Restore') {
            steps {
                sh '''
                    docker run --rm \
                      -v jenkins_home:/var/jenkins_home \
                      -v dotnet_nuget_cache:/root/.nuget \
                      -w "$WORKSPACE" \
                      "$SDK_IMAGE" \
                      dotnet restore Cityinfo.sln
                '''
            }
        }

        
stage('SonarQube Begin') {
    steps {
        withCredentials([
            string(
                credentialsId: 'sonarqube-token',
                variable: 'SONAR_TOKEN'
            )
        ]) {
            sh '''
                docker run --rm \
                  --network devops-net \
                  -e SONAR_TOKEN="$SONAR_TOKEN" \
                  -v jenkins_home:/var/jenkins_home \
                  -v dotnet_nuget_cache:/root/.nuget \
                  -w "$WORKSPACE" \
                  "$SDK_IMAGE" \
                  dotnet sonarscanner begin \
                    /k:"$SONAR_KEY" \
                    /d:sonar.host.url="$SONAR_URL" \
                    /d:sonar.token="$SONAR_TOKEN"
            '''
        }
    }
}

stage('SonarQube Auth Check') {
    steps {
        withCredentials([
            string(
                credentialsId: 'sonarqube-token',
                variable: 'SONAR_TOKEN'
            )
        ]) {
            sh '''
                curl -sS \
                  -u "$SONAR_TOKEN:" \
                  "$SONAR_URL/api/authentication/validate"
            '''
        }
    }
}

        stage('Build') {
            steps {
                sh '''
                    docker run --rm \
                      -v jenkins_home:/var/jenkins_home \
                      -v dotnet_nuget_cache:/root/.nuget \
                      -w "$WORKSPACE" \
                      "$SDK_IMAGE" \
                      dotnet build Cityinfo.sln --no-restore
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    docker run --rm \
                      -v jenkins_home:/var/jenkins_home \
                      -v dotnet_nuget_cache:/root/.nuget \
                      -w "$WORKSPACE" \
                      "$SDK_IMAGE" \
                      dotnet test Cityinfo.sln --no-build \
                        --logger "console;verbosity=normal"
                '''
            }
        }

        
stage('SonarQube End') {
    steps {
        withCredentials([
            string(
                credentialsId: 'sonarqube-token',
                variable: 'SONAR_TOKEN'
            )
        ]) {
            sh '''
                docker run --rm \
                  --network devops-net \
                  -e SONAR_TOKEN="$SONAR_TOKEN" \
                  -v jenkins_home:/var/jenkins_home \
                  -v dotnet_nuget_cache:/root/.nuget \
                  -w "$WORKSPACE" \
                  "$SDK_IMAGE" \
                  dotnet sonarscanner end \
                    /d:sonar.token="$SONAR_TOKEN"
            '''
        }
    }
}


        stage('Docker Build') {
            steps {
                sh '''
                    docker build \
                      -t "$IMAGE_NAME:$IMAGE_TAG" \
                      -f Dockerfile .
                '''
            }
        }
    }

    post {
        success {
            echo 'CI pipeline and SonarQube analysis completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Check the stage logs.'
        }
        always {
            echo 'Pipeline execution finished.'
        }
    }
}
